rules_version = '2';

// Not deployed automatically by being in this repo. Paste into
// Firebase Console -> Firestore Database -> Rules for project "mygoal-8876d",
// or deploy via the Firebase CLI: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /syncedData/{code} {
      // Split get/list: the app only ever fetches ONE known document
      // (by code), so "get" being open is fine — but "list" (querying the
      // whole collection with no code) must be denied, or anyone can
      // enumerate every synced user's data with no code at all.
      allow get: if true;
      allow list: if false;
      allow write: if code.matches('^[A-Z0-9]{8}$')
                   && request.resource.data.keys().hasOnly(['schemaVersion', 'goals', 'streak', 'updatedAt'])
                   && request.resource.data.schemaVersion is int
                   && request.resource.data.goals is list
                   && request.resource.data.goals.size() < 500
                   && request.resource.data.updatedAt is string;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
